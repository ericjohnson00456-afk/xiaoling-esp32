# Resolve legacy logical IDs before project() loads board sdkconfig defaults.
# The source directory and the identity sent to the cloud are independent.
function(xiaoling_resolve_board_dir selection output)
    set(board_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    if(NOT selection)
        set(${output} "" PARENT_SCOPE)
        return()
    endif()
    if(selection MATCHES "(^/|(^|/)\\.\\.?(/|$))")
        message(FATAL_ERROR "Invalid board selection: ${selection}")
    endif()
    if(EXISTS "${board_root}/${selection}/config.json")
        set(${output} "${selection}" PARENT_SCOPE)
        return()
    endif()
    file(GLOB_RECURSE configs "${board_root}/*/config.json")
    foreach(config IN LISTS configs)
        file(READ "${config}" content)
        string(JSON identity ERROR_VARIABLE error GET "${content}" type)
        if(NOT error AND identity STREQUAL selection)
            get_filename_component(directory "${config}" DIRECTORY)
            file(RELATIVE_PATH relative "${board_root}" "${directory}")
            set(${output} "${relative}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Unknown board directory or identity: ${selection}")
endfunction()
