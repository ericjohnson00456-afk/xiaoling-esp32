    set(MWW_MODEL_WAKE_WORD "Alexa")
elseif(CONFIG_MICRO_WAKE_WORD_MODEL_HEY_JARVIS)
    set(MWW_MODEL_ID "hey_jarvis")
    set(MWW_MODEL_WAKE_WORD "Hey Jarvis")
elseif(CONFIG_MICRO_WAKE_WORD_MODEL_HEY_MYCROFT)
    set(MWW_MODEL_ID "hey_mycroft")
    set(MWW_MODEL_WAKE_WORD "Hey Mycroft")
elseif(CONFIG_MICRO_WAKE_WORD_MODEL_OKAY_NABU)
    set(MWW_MODEL_ID "okay_nabu")
    set(MWW_MODEL_WAKE_WORD "Okay Nabu")
elseif(CONFIG_MICRO_WAKE_WORD_MODEL_XIAOLINGXIAOLING)
    set(MWW_MODEL_ID "xiaolingxiaoling")
