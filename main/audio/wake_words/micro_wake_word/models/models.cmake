if(CONFIG_MICRO_WAKE_WORD_MODEL_ALEXA)
    set(MWW_MODEL_ID "alexa")
    set(MWW_MODEL_WAKE_WORD "Alexa")
elseif(CONFIG_MICRO_WAKE_WORD_MODEL_HEY_JARVIS)
    set(MWW_MODEL_ID "hey_jarvis")
    set(MWW_MODEL_WAKE_WORD "Hey Jarvis")
elseif(CONFIG_MICRO_WAKE_WORD_MODEL_HEY_MYCROFT)
    set(MWW_MODEL_ID "hey_mycroft")
    set(MWW_MODEL_WAKE_WORD "Hey Mycroft")
elseif(CONFIG_MICRO_WAKE_WORD_MODEL_OKAY_NABU)
    set(MWW_MODEL_ID "okay_nabu")
    set(MWW_MODEL_WAKE_WORD "Okay Nabu")
elseif(CONFIG_MICRO_WAKE_WORD_MODEL_XIAOLINGXIAOLING)
    set(MWW_MODEL_ID "xiaolingxiaoling")
    set(MWW_MODEL_WAKE_WORD "小聆小聆")
elseif(CONFIG_MICRO_WAKE_WORD_MODEL_HI_LINA)
    set(MWW_MODEL_ID "hi_lina")
    set(MWW_MODEL_WAKE_WORD "Hi Lina")
endif()

if(CONFIG_USE_MICRO_WAKE_WORD)
    if(NOT MWW_MODEL_ID)
        message(FATAL_ERROR "MicroWakeWord is enabled but no model is selected")
    endif()

    set(MWW_MODEL_DIR "${CMAKE_CURRENT_LIST_DIR}/${MWW_MODEL_ID}")
    set(MWW_MODEL_FILE "${MWW_MODEL_DIR}/${MWW_MODEL_ID}.tflite")
    set(MWW_MODEL_DESCRIPTOR "${MWW_MODEL_DIR}/${MWW_MODEL_ID}.json")

    if(NOT EXISTS "${MWW_MODEL_FILE}")
        message(FATAL_ERROR "MicroWakeWord model not found: ${MWW_MODEL_FILE}")
    endif()
    if(NOT EXISTS "${MWW_MODEL_DESCRIPTOR}")
        message(FATAL_ERROR "MicroWakeWord descriptor not found: ${MWW_MODEL_DESCRIPTOR}")
    endif()
endif()
